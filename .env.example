# Copy this file to .env and fill in your own key (get one free at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-key-here

# Main model, then fallbacks tried in order if it is busy or out of quota
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BACKUP_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash

# Public demo settings (leave DEMO_MODE=0 when running for yourself)
DEMO_MODE=0
DAILY_LIMIT=40
VISITOR_LIMIT_PER_HOUR=5
